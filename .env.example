MTS_ENVIRONMENT=development
MTS_DATABASE_URL=postgresql+asyncpg://mts_app:change_me@localhost:5432/mts
MTS_REDIS_URL=redis://localhost:6379/0
MTS_LOG_LEVEL=INFO
MTS_CORS_ORIGINS=["http://localhost:3000"]
# Safety interlocks: changing these does not alone authorize live orders.
MTS_TRADING_MODE=paper
MTS_LIVE_TRADING_ENABLED=false
MTS_LIVE_TRADING_CONFIRMATION=
MTS_BROKER_AUTHENTICATED=false
MTS_RISK_LIMITS_CONFIGURED=false
MTS_PAPER_VALIDATION_PASSED=false
MTS_MARKET_DATA_HEALTHY=false
MTS_BROKER_RECONCILED=false
MTS_AUDIT_LOGGING_ENABLED=true
MTS_KILL_SWITCH_ENABLED=true

