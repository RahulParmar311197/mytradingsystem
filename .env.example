MTS_ENVIRONMENT=development
MTS_DB_OWNER_PASSWORD=REPLACE_WITH_RANDOM_OWNER_PASSWORD
MTS_DB_APP_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD
MTS_DATABASE_URL=postgresql+asyncpg://mts_app:REPLACE_WITH_RANDOM_APP_PASSWORD@localhost:5432/mts
MTS_MIGRATION_DATABASE_URL=postgresql+asyncpg://mts_owner:REPLACE_WITH_RANDOM_OWNER_PASSWORD@localhost:5432/mts
MTS_REDIS_URL=redis://localhost:6379/0
MTS_REDIS_REQUIRED=true
MTS_LOG_LEVEL=INFO
MTS_CORS_ORIGINS=["http://localhost:3000"]
MTS_TRADING_MODE=paper
MTS_LIVE_TRADING_ENABLED=false
MTS_LIVE_TRADING_CONFIRMATION=
# Optional OTLP HTTP trace destination (append /v1/traces as required).
# MTS_OTEL_ENDPOINT=http://collector:4318/v1/traces
# Broker configuration for later adapters; no adapters are enabled in this release.
# MTS_UPSTOX_CLIENT_ID=
# MTS_UPSTOX_CLIENT_SECRET=
# MTS_UPSTOX_REDIRECT_URI=
# MTS_UPSTOX_ACCESS_TOKEN=
# MTS_DHAN_CLIENT_ID=
# MTS_DHAN_ACCESS_TOKEN=
