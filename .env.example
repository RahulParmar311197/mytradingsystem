MTS_ENVIRONMENT=development
MTS_DATABASE_URL=postgresql+asyncpg://mts_app:change_me@localhost:5432/mts
MTS_REDIS_URL=redis://localhost:6379/0
MTS_LOG_LEVEL=INFO
MTS_CORS_ORIGINS=["http://localhost:3000"]
# Safety interlocks: changing these does not alone authorize live orders.
MTS_TRADING_MODE=paper
MTS_LIVE_TRADING_ENABLED=false
MTS_LIVE_TRADING_CONFIRMATION=
MTS_BROKER_AUTHENTICATED=false
MTS_RISK_LIMITS_CONFIGURED=false
MTS_PAPER_VALIDATION_PASSED=false
MTS_MARKET_DATA_HEALTHY=false
MTS_BROKER_RECONCILED=false
MTS_AUDIT_LOGGING_ENABLED=true
MTS_KILL_SWITCH_ENABLED=true
# Optional protected API access; inject distinct random values (32+ characters) from a secret manager.
MTS_API_VIEWER_TOKEN=
MTS_API_OPERATOR_TOKEN=
# Optional one-window rotation grace; old tokens are rejected at/after this aware ISO-8601 timestamp.
MTS_API_PREVIOUS_VIEWER_TOKEN=
MTS_API_PREVIOUS_OPERATOR_TOKEN=
MTS_API_PREVIOUS_TOKENS_EXPIRE_AT=
# JSON list of lowercase SHA-256 token digests for immediate configuration-driven revocation.
MTS_API_REVOKED_TOKEN_SHA256=[]
# Enable only after migration 0011 is applied; lookup failures deny protected requests.
MTS_API_PERSISTENT_REVOCATION_ENABLED=false
# Broker credentials are optional for offline tests and must come from a secret manager in deployment.
MTS_UPSTOX_ACCESS_TOKEN=
MTS_DHAN_CLIENT_ID=
MTS_DHAN_ACCESS_TOKEN=
